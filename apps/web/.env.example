# Template for apps/web/.env.local and the Vercel project. Catalogue and phases:
# openspec/specs/env/spec.md. Check with `pnpm verify:env`.

# Sentry — https://<key>@<org>.ingest.sentry.io/<project-id>
NEXT_PUBLIC_SENTRY_DSN=
# Optional; defaults to the Vercel environment.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Build-time only, for source-map upload. Leave empty locally.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog — phc_...
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# Supabase (server only) — Project settings → Data API / API Keys
SUPABASE_URL=
# sb_secret_... — never expose to the browser.
SUPABASE_SECRET_KEY=

# AI Gateway — local only; Vercel deployments authenticate with OIDC.
AI_GATEWAY_API_KEY=
# Optional; vision calls per UTC day, defaults to 200. Changing it on Vercel needs a redeploy.
DAILY_ANALYSIS_CAP=

# Resend (server only) — API Keys, sending access only. re_...
RESEND_API_KEY=

# Retention cron (server only) — any random string, 32+ chars (openssl rand -hex 32). Vercel sends
# it as the cron request's bearer token; unset, the route refuses every request.
CRON_SECRET=
